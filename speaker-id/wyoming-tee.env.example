TEE_HOST=0.0.0.0
TEE_PORT=10301
REAL_STT_HOST=127.0.0.1
REAL_STT_PORT=10300
EMBED_URL=http://127.0.0.1:8099/identify
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/REPLACE_WITH_LONG_RANDOM_ID
DEVICE_ID=voice_satellite
SHADOW=1
LOG_LEVEL=INFO

IDENTIFY_TIMEOUT_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=3
WEBHOOK_RETRIES=4
WEBHOOK_RETRY_BASE_SECONDS=0.5
WEBHOOK_RETRY_MAX_SECONDS=5

MAX_UTTERANCE_BYTES=16777216
MAX_FRAME_BYTES=33554432
MAX_HEADER_BYTES=65536
RELAY_BUFFER_BYTES=65536
SHUTDOWN_GRACE_SECONDS=10

# Set temporarily to save each utterance as a WAV for later enrollment.
CAPTURE_USER=
CAPTURE_DIR=/opt/speaker-id/data/captures
