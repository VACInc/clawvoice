# Listener
SPEAKER_HOST=0.0.0.0
SPEAKER_PORT=8099
LOG_LEVEL=INFO

# Artifacts and enrollment store
MODEL_DIR=/opt/speaker-id/models
ENROLLMENT_DIR=/opt/speaker-id/data/enrollments
# REDIMNET_SOURCE_DIR=/opt/speaker-id/models/redimnet-9438b1e98018d831df15fde93c580faae0a28d63
# REDIMNET_CHECKPOINT=/opt/speaker-id/models/M-vb2+vox2+cnc-ft_mix.pt
DEVICE=auto
VERIFY_MODEL_HASHES=1

# Primary decision policy. SHADOW defaults on and must stay on for the pilot.
LOW_THRESHOLD=0.55
HIGH_THRESHOLD=0.72
SHADOW=1
ALLOWED_ENROLL_USERS=alice

# Optional report-only TitaNet-L scorer
TITANET_ENABLED=0
# TITANET_CHECKPOINT=/opt/speaker-id/models/speakerverification_en_titanet_large.nemo
TITANET_LOW_THRESHOLD=0.50
TITANET_HIGH_THRESHOLD=0.65

# Audio/API limits
RAW_SAMPLE_RATE=16000
RAW_CHANNELS=1
MIN_AUDIO_MS=300
MAX_AUDIO_SECONDS=30
MAX_BODY_BYTES=16777216
